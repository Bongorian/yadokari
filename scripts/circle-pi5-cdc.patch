+void CDWUSBGadgetEndpoint::SlavePushInData (void)
+{
+	// Push as much of the armed IN transfer as currently fits into this
+	// EP's TxFIFO. Called when the EP is enabled in BeginTransfer() and
+	// again from the TXFE interrupt if the FIFO drains mid-transfer.
+	// The core segments the byte stream into packets per DIEPTSIZ and
+	// decrements it as packets are transmitted, so FinishTransfer()
+	// accounting is the same as in DMA mode. Bytes past the transfer
+	// size in the final word are padding and are never transmitted.
+	if (m_TransferMode != TransferDataIn || !m_pSlaveCursor)
+	{
+		return;
+	}
+
+	assert (m_nSlaveMoved <= m_nTransferLength);
+	size_t nRemaining = m_nTransferLength - m_nSlaveMoved;
+	if (!nRemaining)
+	{
+		return;		// e.g. a zero-length packet: XFRC completes it
+	}
+
+	// Free TxFIFO space in bytes. DTXFSTS reports the shared
+	// non-periodic FIFO for EP0 and the dedicated FIFO for other IN EPs.
+	CDWHCIRegister TxFIFOStat (DWHCI_DEV_IN_EP_TX_FIFO_STAT (m_nEP));
+	size_t nSpace = (TxFIFOStat.Read () & DWHCI_DEV_IN_EP_TX_FIFO_STAT_SPACE__MASK) * 4;
+	if (nSpace > nRemaining)
+	{
+		nSpace = nRemaining;
+	}
+
+	volatile u32 *pFIFO = (volatile u32 *) DWHCI_DEV_EP_FIFO (m_nEP);
+	size_t nWords = (nSpace + 3) / 4;
+	for (size_t i = 0; i < nWords; i++)
+	{
+		u32 nWord = 0;
+		for (unsigned j = 0; j < 4; j++)
+		{
+			size_t nIndex = i*4 + j;
+			if (nIndex < nSpace)
+			{
+				nWord |= (u32) m_pSlaveCursor[nIndex] << (j * 8);
+			}
+		}
+
+		*pFIFO = nWord;
+	}
+
+	m_pSlaveCursor += nSpace;
+	m_nSlaveMoved += nSpace;
+}
+
+#endif
