+void CDWUSBGadget::HandleRxFIFOLevel (void)
+{
+	// PI5 EXPERIMENT (CDC step 2 2026-11-12): slave-mode RxFIFO drain.
+	// Behavioural reference: dwc2_hsotg_handle_rx() in Linux's
+	// drivers/usb/dwc2/gadget.c. GINTSTS.RxFLvl is level-triggered on
+	// the receive status queue being non-empty; every iteration
+	// re-reads it and only then pops one GRXSTSR entry, because the
+	// status snapshot taken in InterruptHandler() may be stale (a USB
+	// reset in the same pass flushes the queue). The loop is bounded;
+	// if more packets arrive than one pass drains, the level interrupt
+	// simply fires again.
+	CDWHCIRegister IntStatus (DWHCI_CORE_INT_STAT);
+
+	s_IrqDiag.nEvRxFifoLevel++;	// PI5 EXPERIMENT (CDC step 6)
+
+	for (unsigned nGuard = 0; nGuard < 1024; nGuard++)
+	{
+		if (!(IntStatus.Read () & DWHCI_CORE_INT_MASK_RX_STS_Q_LVL))
+		{
+			break;
+		}
+
+		CDWHCIRegister RxStatus (DWHCI_CORE_RX_STAT_POP);
+		u32 nStatus = RxStatus.Read ();
+
+		s_IrqDiag.nRxStsLast = nStatus;	// PI5 EXPERIMENT (CDC step 6)
+
+		unsigned nEP = nStatus & DWHCI_CORE_RX_STAT_CHAN_NUMBER__MASK;
+		unsigned nByteCount =   (nStatus & DWHCI_CORE_RX_STAT_BYTE_COUNT__MASK)
+				      >> DWHCI_CORE_RX_STAT_BYTE_COUNT__SHIFT;
+		unsigned nPktStatus =   (nStatus & DWHCI_CORE_RX_STAT_PACKET_STATUS__MASK)
+				      >> DWHCI_CORE_RX_STAT_PACKET_STATUS__SHIFT;
+
+		switch (nPktStatus)
+		{
+		case DWHCI_CORE_RX_STAT_PKTSTS_DEV_OUT_DATA:
+		case DWHCI_CORE_RX_STAT_PKTSTS_DEV_SETUP_DATA:
+			// PI5 EXPERIMENT (CDC step 6): count the receive
+			// entries the pump actually pops, split by kind.
+			if (nPktStatus == DWHCI_CORE_RX_STAT_PKTSTS_DEV_SETUP_DATA)
+			{
+				s_IrqDiag.nEvSetup++;
+			}
+			else
+			{
+				s_IrqDiag.nEvOutData++;
+			}
+
+			if (nEP <= NumberOfEPs && m_pEP[nEP])
+			{
+				m_pEP[nEP]->SlaveReceivePacket (nByteCount);
+			}
+			else
+			{
+				// No endpoint object owns this packet: read and
+				// drop it, so the RxFIFO cannot wedge.
+				volatile u32 *pFIFO = (volatile u32 *) DWHCI_DEV_EP_FIFO (nEP & 0xF);
+				for (unsigned i = 0; i < (nByteCount + 3) / 4; i++)
+				{
+					(void) *pFIFO;
+				}
+			}
+			break;
+
+		default:
+			// Global OUT NAK, OUT transfer done and SETUP done carry
+			// no FIFO data; the per-EP interrupts (XFRC, SETUP_DONE)
+			// report them through the existing dispatch.
+			break;
+		}
+	}
+}
