+// PI5 EXPERIMENT (CDC step 2 2026-11-12): slave-mode (PIO) packet pump.
+// Behavioural reference: the slave-mode helpers of Linux's
+// drivers/usb/dwc2/gadget.c. Everything in this section is compiled
+// only on BCM2712; the DMA path above is the only path on other models.
+
+void CDWUSBGadgetEndpoint::SlaveReceivePacket (unsigned nByteCount)
+{
+	// Pop one received packet (nByteCount bytes, per GRXSTSR) from this
+	// EP's DFIFO window into the armed OUT/SETUP transfer buffer. The
+	// word count is driven by the packet, not by the space left in the
+	// transfer: the RxFIFO must be drained either way, so surplus bytes
+	// (or bytes for an EP with no armed OUT transfer) are read and
+	// dropped. Completion is unchanged: the core decrements DOEPTSIZ
+	// as data is popped and raises XFRC, which FinishTransfer() reports
+	// exactly as in DMA mode.
+	unsigned nWords = (nByteCount + 3) / 4;
+
+	boolean bStore =    (m_TransferMode == TransferSetupOut
+			  || m_TransferMode == TransferDataOut)
+			 && m_pSlaveCursor != nullptr;
+
+	size_t nSpace = 0;
+	if (bStore)
+	{
+		assert (m_nSlaveMoved <= m_nTransferLength);
+		nSpace = m_nTransferLength - m_nSlaveMoved;
+	}
+
+	volatile u32 *pFIFO = (volatile u32 *) DWHCI_DEV_EP_FIFO (m_nEP);
+	for (unsigned i = 0; i < nWords; i++)
+	{
+		u32 nWord = *pFIFO;
+
+		for (unsigned j = 0; j < 4; j++)
+		{
+			unsigned nIndex = i*4 + j;
+			if (nIndex >= nByteCount)
+			{
+				break;
+			}
+
+			if (bStore && nIndex < nSpace)
+			{
+				*m_pSlaveCursor++ = (u8) (nWord & 0xFF);
+			}
+
+			nWord >>= 8;
+		}
+	}
+
+	if (bStore)
+	{
+		m_nSlaveMoved += nByteCount < nSpace ? nByteCount : nSpace;
+	}
+}
